{
	"name": "@sauna-studio/web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "bun --bun vite dev --host 127.0.0.1",
		"build": "bun --bun vite build",
		"preview": "bun --bun vite preview --host 127.0.0.1",
		"start": "HOST=127.0.0.1 PORT=5173 bun ./build",
		"prepare": "bun --bun svelte-kit sync",
		"check": "bun --bun svelte-kit sync && bun --bun svelte-check --tsconfig ./tsconfig.json",
		"lint": "bun --bun prettier --check . && bun --bun eslint .",
		"format": "bun --bun prettier --write .",
		"test:unit": "bun --bun vitest run",
		"test:e2e": "bun --bun playwright test",
		"test": "bun run test:unit",
		"api:generate": "bun --bun openapi-typescript openapi/sauna-api.yaml -o src/lib/api/schema.d.ts",
		"api:smoke": "bun scripts/check-local-api.ts",
		"test:auth": "bun --bun playwright test --config playwright.auth.config.ts"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@internationalized/date": "3.12.4",
		"@playwright/test": "1.64.1",
		"@sveltejs/adapter-bun": "1.0.0",
		"@sveltejs/kit": "3.1.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "26.6.6",
		"bits-ui": "2.20.2",
		"cn": "0.5.1",
		"eslint": "10.14.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.23.1",
		"globals": "17.13.0",
		"openapi-typescript": "7.13.0",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"prettier-plugin-tailwindcss": "0.8.1",
		"shadcn-svelte": "1.7.2",
		"svelte": "5.57.3",
		"svelte-check": "4.7.7",
		"tailwind-variants": "3.3.1",
		"tailwindcss": "4.3.3",
		"tw-animate-css": "1.4.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.1",
		"vite": "8.3.5",
		"vitest": "5.0.5"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"packageManager": "bun@1.4.4",
	"engines": {
		"bun": "1.4.4"
	},
	"dependencies": {
		"@lucide/svelte": "1.66.0",
		"openapi-fetch": "0.17.0",
		"sveltekit-superforms": "3.1.0",
		"zod": "4.6.7"
	}
}
